# Copy to .env and fill in. Never commit the real .env.
APP_ENV=production
DB_NAME=gofix
# APP_ENV=production enables startup safety checks: the API refuses to start with a weak JWT_SECRET / ADMIN_PASSWORD,
# a non-https FRONTEND_URL, localhost in CORS_ORIGINS or PAYMENT_PROVIDER=mock. API docs (/api/docs) are then hidden.
# EXPOSE_API_DOCS=false
# ALLOW_MOCK_PAYMENTS=false   # true only on a staging server

# MongoDB. Default (docker-compose): mongodb://mongo:27017 without authentication.
# Production: set both values below BEFORE the first start (they only apply to a new, empty volume) and
# MONGO_URL=mongodb://<user>:<password>@mongo:27017/?authSource=admin
# MONGO_ROOT_USER=
# MONGO_ROOT_PASSWORD=
# MONGO_URL=mongodb://localhost:27017

# Ports published by the Nginx container. Default 80/443 (dedicated server).
# Server managed by aaPanel (its Nginx already uses 80/443): HTTP_BIND=127.0.0.1:8080, HTTPS_BIND=127.0.0.1:8443,
# then an aaPanel reverse proxy to http://127.0.0.1:8080 with its Let's Encrypt certificate.
# HTTP_BIND=80
# HTTPS_BIND=443

# Public URL of the site (used in payment return URLs and e-mails)
FRONTEND_URL=https://gofix.dz
CORS_ORIGINS=https://gofix.dz,https://www.gofix.dz

# JWT: generate with `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# First super-admin (created/updated at startup)
ADMIN_EMAIL=admin@gofix.dz
ADMIN_PASSWORD=change-me-strong-password

# Storage (local disk; "s3" for MinIO later)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage

# SMS: console (prints code in logs) | http (Algerian SMS gateway)
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=GOFIX

# E-mail: console | smtp
# E-mails: preferably set in the back-office (Admin > E-mails); the values below are only the fallback.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gofix.dz
SMTP_TLS=true

# Payment: DEFAULT values only. The super-admin chooses and configures the gateway in the back-office
# (tab « Moyen de paiement »); once saved there, these variables are ignored. mock is refused in production.
# Key used to encrypt secrets typed in the back-office (SATIM password). Default: derived from JWT_SECRET.
# CONFIG_ENCRYPTION_KEY=
# Payment: mock | satim (CIB / Edahabia)
PAYMENT_PROVIDER=mock
SATIM_BASE_URL=
SATIM_USERNAME=
SATIM_PASSWORD=
SATIM_TERMINAL_ID=

# LLM (chatbot rephrasing, also behind the `chatbot_llm` feature flag): none | openai_compatible
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Mobile app deep-link scheme (payment return)
MOBILE_APP_SCHEME=gofix
