{
  "expo": {
    "name": "GoFix",
    "slug": "gofix",
    "scheme": "gofix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070911",
    "ios": {
      "bundleIdentifier": "dz.gofix.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GoFix utilise vos photos pour votre photo de profil, votre image de couverture et vos justificatifs.",
        "NSCameraUsageDescription": "GoFix utilise l'appareil photo pour votre photo de profil et vos justificatifs.",
        "NSLocationWhenInUseUsageDescription": "GoFix utilise votre position, uniquement si vous le demandez, pour proposer votre wilaya. Elle n'est pas enregistrée."
      }
    },
    "android": {
      "package": "dz.gofix.app",
      "adaptiveIcon": {
        "backgroundColor": "#070911",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gofix"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070911"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoFix utilise vos photos pour votre photo de profil, votre image de couverture et vos justificatifs."
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoFix utilise votre position, uniquement si vous le demandez, pour proposer votre wilaya. Elle n'est pas enregistrée.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00C8F0"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost"
    }
  }
}
